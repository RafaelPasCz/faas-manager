# Porta HTTP do FaaS Manager
SERVER_PORT=8080

# Configuração TCP/IP do PostgreSQL Isolado
DB_HOST=localhost
DB_PORT=5432
DB_NAME=faas_manager
DB_USER=faas_admin
DB_PASSWORD=1234

# Configurações do Hibernate / JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Origens permitidas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200
